{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ucrt64-debug",
      "displayName": "MSYS2 UCRT64 (Debug)",
      "description": "GCC 16.1.0 + Ninja，供 VS Code CMake Tools 使用",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}",
        "MSYSTEM": "UCRT64"
      }
    },
    {
      "name": "ucrt64-release",
      "displayName": "MSYS2 UCRT64 (Release)",
      "description": "GCC 16.1.0 + Ninja，发布版，静态链接",
      "inherits": "ucrt64-debug",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXE_LINKER_FLAGS": "-static -static-libgcc -static-libstdc++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ucrt64-debug",
      "configurePreset": "ucrt64-debug"
    },
    {
      "name": "ucrt64-release",
      "configurePreset": "ucrt64-release"
    }
  ]
}
