cmake_minimum_required(VERSION 3.21)

# 工程名可自行修改
project(Chapter2Project LANGUAGES C CXX)

# ---------- 语言标准 ----------
set(CMAKE_C_STANDARD 17)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# 让 VS Code 能找到编译数据库（IntelliSense 更准）
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

# ---------- 统一输出目录 ----------
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR})
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_DEBUG ${CMAKE_BINARY_DIR})
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE ${CMAKE_BINARY_DIR})

# ---------- 源码 ----------
# 自动收集本目录下所有 .c / .cpp / .cc
# 你新增源文件后无需修改本文件；若不想自动收集，改成显式列表即可
file(GLOB SOURCES
    "${CMAKE_CURRENT_SOURCE_DIR}/*.c"
    "${CMAKE_CURRENT_SOURCE_DIR}/*.cpp"
    "${CMAKE_CURRENT_SOURCE_DIR}/*.cc"
)
# 若把源码放进 src/ 子目录，取消下面两行注释并删掉上面几行
# file(GLOB SOURCES "${CMAKE_CURRENT_SOURCE_DIR}/src/*.c" "${CMAKE_CURRENT_SOURCE_DIR}/src/*.cpp")

if(NOT SOURCES)
    message(WARNING "没找到任何源文件，请先把 .c/.cpp 放到工程根目录（或修改 CMakeLists.txt 里的源码路径）")
    return()
endif()

add_executable(${PROJECT_NAME} ${SOURCES})

# ---------- 中文与告警 ----------
# 不加 -finput-charset/-fexec-charset：GCC 默认输入与执行字符集都是 UTF-8，
# 显式指定只会多一个可能失败的环节（曾出现 illegal byte sequence 报错）
target_compile_options(${PROJECT_NAME} PRIVATE
    -Wall
    -Wextra
)

# Release 下静态链接，生成的 exe 不依赖 MSYS2 运行库，方便提交
set_target_properties(${PROJECT_NAME} PROPERTIES
    RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}
)
